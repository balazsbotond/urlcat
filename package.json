{
  "name": "urlcat",
  "version": "3.1.0",
  "description": "A library for concatenating URL's.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/balazsbotond/urlcat.git"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "lint": "eslint .",
    "prepublish": "npm test && npm run build",
    "docs": "npx docsify-cli@5.0.0 serve docs --open"
  },
  "keywords": [
    "url",
    "uri",
    "build",
    "builder",
    "concat",
    "concatenate"
  ],
  "author": "Botond Balazs",
  "license": "MIT",
  "dependencies": {
    "qs": "^6.9.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/qs": "6.15.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "ts-jest": "29.4.14",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
