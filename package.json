{
  "name": "urlcat",
  "version": "3.2.0",
  "description": "A library for concatenating URL's.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/balazsbotond/urlcat.git"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint .",
    "check:package": "attw --pack . && publint",
    "prepublishOnly": "npm run lint && npm test && npm run build && npm run check:package",
    "docs": "npx docsify-cli@5.0.0 serve docs --open"
  },
  "keywords": [
    "url",
    "uri",
    "build",
    "builder",
    "concat",
    "concatenate"
  ],
  "author": "Botond Balazs",
  "license": "MIT",
  "dependencies": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@types/qs": "6.15.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "publint": "0.3.25",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
